{
  "name": "citograph",
  "version": "1.4.3",
  "description": "A local-first research and citation workspace",
  "author": {
    "name": "Ali Afruz",
    "email": "a.a.afruz@gmail.com"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "desktop": "electron .",
    "build": "vite build && node scripts/build-word-bridge.mjs",
    "build:word": "powershell -NoProfile -ExecutionPolicy Bypass -File word-addin/Build.ps1",
    "test:word": "node --test tests/word-bridge.test.mjs",
    "test:word-native": "node scripts/word-smoke.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:reader": "node scripts/reader-backup-smoke.mjs",
    "package": "npm run build && electron-builder --win dir",
    "installer": "npm run build && electron-builder --win nsis",
    "test:styles": "node scripts/style-smoke.mjs",
    "test:libraries": "node scripts/library-smoke.mjs",
    "test:nbib": "node scripts/nbib-smoke.mjs",
    "test:migration": "node scripts/word-migration-smoke.mjs",
    "test:readability": "node scripts/readability-smoke.mjs",
    "test:atlas": "node scripts/atlas-smoke.mjs",
    "test:migration-recovery": "node scripts/migration-recovery-smoke.mjs"
  },
  "devDependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@citation-js/plugin-ris": "0.9.0",
    "citeproc": "2.4.63",
    "dompurify": "^3.3.0",
    "lucide-react": "1.54.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@vitejs/plugin-react": "latest",
    "@playwright/test": "latest",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.4",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.citograph.desktop",
    "productName": "Citograph",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "word-addin",
        "to": "word-addin",
        "filter": [
          "bin/Citograph.Word.dll",
          "bin/Citograph.StyleHost.exe",
          "Install.ps1",
          "Uninstall.ps1",
          "WORD_GUIDE.md"
        ]
      },
      {
        "from": "Install Word Add-in.cmd",
        "to": "Install Word Add-in.cmd"
      },
      {
        "from": "Uninstall Word Add-in.cmd",
        "to": "Uninstall Word Add-in.cmd"
      },
      {
        "to": "python",
        "from": "python",
        "filter": [
          "*.py",
          "README.md",
          "runtime/**/*",
          "examples/**/*"
        ]
      },
      {
        "from": "STYLE_STUDIO_GUIDE.md",
        "to": "STYLE_STUDIO_GUIDE.md"
      },
      {
        "from": "LIBRARY_FILES_GUIDE.md",
        "to": "LIBRARY_FILES_GUIDE.md"
      },
      {
        "from": "ENDNOTE_MIGRATION_GUIDE.md",
        "to": "ENDNOTE_MIGRATION_GUIDE.md"
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "word-addin/installer.nsh"
    },
    "fileAssociations": [
      {
        "role": "Editor",
        "name": "Citograph Library",
        "description": "Portable Citograph research library",
        "ext": "citograph"
      }
    ],
    "copyright": "Copyright © 2026 Ali Afruz"
  },
  "repository": {
    "url": "https://github.com/AliAfruz/Citograph.git",
    "type": "git"
  }
}
